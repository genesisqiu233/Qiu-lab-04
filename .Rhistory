deviance,
df.residual,
Nested.df,
Nested.Chisq.stat,
Nested.p.value
) |>
gt() |>
cols_label(
Model = "Model",
AIC = "AIC",
BIC = "BIC",
logLik = "Log-likelihood",
deviance = "Deviance",
df.residual = "Residual df",
Nested.df = "Nested df",
Nested.Chisq.stat = "Nested χ²",
Nested.p.value = "Nested p"
) |>
fmt_number(
columns = c(
AIC,
BIC,
logLik,
deviance,
Nested.Chisq.stat
),
decimals = 3
) |>
fmt(
columns = Nested.p.value,
fns = function(x) {
ifelse(
is.na(x),
"—",
ifelse(x < .001, "< .001", sprintf("%.3f", x))
)
}
) |>
sub_missing(
columns = c(Nested.df, Nested.Chisq.stat),
missing_text = "—"
)
