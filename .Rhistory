library(glmmTMB)
library(dplyr)
library(tidyr)
library(ggplot2)
library(broom.mixed)
library(performance)
library(gt)
library(readr)
library(DHARMa)
library(ggeffects)
library(titanic)
titanic <- titanic_train
# Keep the same complete-case sample for every model
titanic <- titanic |>
select(Survived, Sex, Age, Pclass) |>
drop_na() |>
mutate(
Sex.Binary = case_when(
Sex == "male" ~ 0,
Sex == "female" ~ 1)) |>
mutate(
Survived.Char = case_when(
Survived == 0 ~ "Died",
Survived == 1 ~ "Survived")) |>
mutate(
Pclass.Char = case_when(
Pclass == "1" ~ "First Class",
Pclass == "2" ~ "Second Class",
Pclass == "3" ~ "Third Class")) |>
mutate(Pclass = factor(Pclass, levels = c(1, 2, 3))) |>
select(Survived, Survived.Char, Sex, Sex.Binary, Pclass, Pclass.Char, Age)
n <- nrow(titanic)
descriptives <- titanic |>
summarise(
across(
c(Age),
list(mean = mean, sd = sd, min = min, max = max)
)
) |>
pivot_longer(
everything(),
names_to = c("variable", ".value"),
names_sep = "_"
)
descriptives |>
gt() |>
cols_label(
variable = "Variable",
mean = "Mean",
sd = "SD",
min = "Minimum",
max = "Maximum"
) |>
fmt_number(columns = where(is.numeric), decimals = 2)
titanic |>
count(Survived.Char) |>
gt() |>
cols_label(
Survived.Char = "Survival Status",
n = "Count"
)
titanic |>
count(Sex) |>
gt() |>
cols_label(
Sex = "Sex",
n = "Count"
)
titanic |>
count(Pclass.Char) |>
gt() |>
cols_label(
Pclass.Char = "Ticket Class",
n = "Count"
)
mod0 <- glmmTMB(
Survived ~ 1,
data = titanic,
family = binomial(link = "logit")
)
mod1 <- glmmTMB(
Survived ~ Sex,
data = titanic,
family = binomial(link = "logit")
)
mod2 <- glmmTMB(
Survived ~ Sex + Pclass,
data = titanic,
family = binomial(link = "logit")
)
mod3 <- glmmTMB(
Survived ~ Sex + Pclass + Age,
data = titanic,
family = binomial(link = "logit")
)
tests <- anova(mod0, mod1, mod2, mod3)
tests
tests <- tests |>
select(Chisq, `Chi Df`, `Pr(>Chisq)`) |>
rename(
Nested.df = `Chi Df`,
Nested.Chisq.stat = Chisq,
Nested.p.value = `Pr(>Chisq)`
)
glance0 <- broom.mixed::glance(mod0)
glance1 <- broom.mixed::glance(mod1)
glance2 <- broom.mixed::glance(mod2)
glance3 <- broom.mixed::glance(mod3)
mods <- c(
"mod0: Null",
"mod1: Sex",
"mod2: Sex + Pclass",
"mod3: Sex + Pclass + Age"
)
glances <- rbind(
glance0,
glance1,
glance2,
glance3
)
comparison_table <- cbind(
Model = mods,
glances,
tests
)
comparison_table |>
select(
Model,
AIC,
BIC,
logLik,
deviance,
df.residual,
Nested.df,
Nested.Chisq.stat,
Nested.p.value
) |>
gt() |>
cols_label(
Model = "Model",
AIC = "AIC",
BIC = "BIC",
logLik = "Log-likelihood",
deviance = "Deviance",
df.residual = "Residual df",
Nested.df = "Nested df",
Nested.Chisq.stat = "Nested χ²",
Nested.p.value = "Nested p"
) |>
fmt_number(
columns = c(
AIC,
BIC,
logLik,
deviance,
Nested.Chisq.stat
),
decimals = 3
) |>
fmt(
columns = Nested.p.value,
fns = function(x) {
ifelse(
is.na(x),
"—",
ifelse(x < .001, "< .001", sprintf("%.3f", x))
)
}
) |>
sub_missing(
columns = c(Nested.df, Nested.Chisq.stat),
missing_text = "—"
)
performance_comparison <- compare_performance(
mod0,
mod1,
mod2,
mod3,
rank = TRUE
)
